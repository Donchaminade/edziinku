# Base PostgreSQL / PostGIS (voir docker-compose.yml)
DATABASE_URL=jdbc:postgresql://localhost:5432/edziinku
DATABASE_USER=edziinku
DATABASE_PASSWORD=edziinku

# API
PORT=8080
APP_ENV=dev
JWT_SECRET=changez-moi-avec-une-chaine-d-au-moins-32-caracteres
JWT_TTL=900
JWT_REFRESH_TTL=604800
PUBLIC_WEB_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173,http://localhost:4173
UPLOAD_DIR=storage/uploads
SWAGGER_ENABLED=true

# Météo Open-Meteo (Lomé)
WEATHER_LATITUDE=6.1725
WEATHER_LONGITUDE=1.2314

# Google OAuth — prévu, non branché tant que le client id est vide
GOOGLE_CLIENT_ID=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=edzii-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Web
VITE_API_URL=http://localhost:8080
